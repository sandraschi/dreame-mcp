{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "stabilityDays": 3,
  "prConcurrentLimit": 3,
  "schedule": ["on Monday"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackagePatterns": ["^fastmcp$", "^pydantic$"],
      "automerge": false
    }
  ]
}
